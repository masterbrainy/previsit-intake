# Copy to .env and fill in. .env is gitignored; never commit real keys.
OPENAI_API_KEY=
PHYSICIAN_USERNAME=doctor
PHYSICIAN_PASSWORD=
# Optional overrides
# DATABASE_URL=sqlite:///var/previsit.db
# BASE_URL=http://localhost:8000
# EMERGENCY_NUMBER=911
# CRISIS_LINE=988
# CLINIC_NAME=your clinic
# INTERVIEW_MODEL=gpt-5.4-mini
# EXTRACTION_MODEL=gpt-5.4
# SAFETY_MODEL=gpt-5.4-mini

# Patient portal. PORTAL_SECRET signs sign-in codes (random per start if empty). DEMO_MODE shows codes on screen and
# must only be used with synthetic data, because no SMS/email provider is connected yet.
PORTAL_SECRET=
DEMO_MODE=false
